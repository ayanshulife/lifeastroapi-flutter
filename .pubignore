# .pubignore replaces .gitignore for `dart pub publish`, so it repeats it.
.dart_tool/
.packages
build/
pubspec.lock
doc/api/
live-dump/
.env
.env.*
.DS_Store

# Test fixtures (API examples, PDF golden HTML); the tests run from the git
# repo. Keep this: without it the package carries more than 6 MB of test data.
test/fixtures/
